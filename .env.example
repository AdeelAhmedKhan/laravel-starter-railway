# Laravel starter — PLACEHOLDERS ONLY. Never put a real key, password
# or token in this file. Copy to .env and fill in real values.
#
# --- App ----------------------------------------------------------------
APP_NAME="Laravel Starter"
APP_ENV=production
APP_KEY=
# Generate with: php artisan key:generate --show
# The app REFUSES to boot in production without APP_KEY (see
# docker/entrypoint.sh). Never commit a real APP_KEY.
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app
APP_TIMEZONE=UTC

# --- Database -----------------------------------------------------------
# Locally (parity testing only): SQLite at database/database.sqlite.
# The Postgres path is implemented but NOT live-tested locally — see README.
DB_CONNECTION=sqlite
# On Railway: set BOTH of these on the app service —
#   DB_CONNECTION=pgsql
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (reference variable to the
#   Postgres service; Railway fills in the real connection string)
# Laravel reads DB_URL by default; config/database.php also accepts
# DATABASE_URL, so the Railway reference variable works as-is.
DATABASE_URL=

# --- Sessions / cache / queue -------------------------------------------
# Secure cookie defaults are enforced in config/session.php and
# docker/php/security.ini (secure, http_only, same_site=lax).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (optional) ----------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ------------------------------------------------------------
# Token-based API auth. No password/token defaults exist anywhere in
# this repo; tokens are issued by POST /api/auth/login and stored
# hashed (sha256) in the database.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# --- Logging ------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
